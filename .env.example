# Copy to .env for local development. Never commit real values.
PORT=3000
TZ_PUBLIC_ORIGIN=http://localhost:3000
TZ_DATA_DIR=
TZ_STORAGE_DURABILITY=ephemeral
TZ_IDENTITY=builtin
DATABASE_URL=
BETTER_AUTH_SECRET=
TZ_INTROSPECTION_CLIENT_SECRET=
TZ_OPERATOR_TOKEN=
# Proxy hops in front of the app whose X-Forwarded-For is trusted (0-3; Render: 1).
TZ_TRUSTED_PROXY_HOPS=0
# Comma-separated HTTPS origins allowed to serve station/release artwork (empty = none).
TZ_ARTWORK_ORIGINS=
# ISO 3166-1 alpha-2 region used for rights/territory checks (default US).
TZ_RIGHTS_REGION=US
# External IdP alternative (TZ_IDENTITY=external):
# TZ_INTROSPECTION_ENDPOINT= TZ_ISSUER= TZ_CLIENT_ID= TZ_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
